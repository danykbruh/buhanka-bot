# Скопируйте в bot/.env и заполните. Файл .env не коммитится.

# Токен от @BotFather
BOT_TOKEN=

# Куда дублировать заказы: ваш числовой user id (узнать у @userinfobot) или id группы (начинается с -100)
ADMIN_CHAT_ID=

# Необязательно: свои пути (по умолчанию ../webapp/menu.json, ../webapp/bakeries.js, bot/logs, bot/data)
# MENU_FILE=
# BAKERIES_FILE=
# LOG_DIR=
# DATA_DIR=

# Адрес мини-аппа, строго https
WEBAPP_URL=https://<ваш-логин>.github.io/<репозиторий>/
